{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightoverleaf:rpc:v2:export",
  "$defs": {
    "ExportSelectDestinationRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "export.selectDestination" },
        "params": { "type": "object", "additionalProperties": false, "required": [], "properties": {} }
      }
    },
    "ExportSelectDestinationResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "const": "export.selectDestination" },
        "result": { "type": "object", "additionalProperties": false,
          "required": ["destinationToken", "displayName", "expiresAtUnixMs"], "properties": {
            "destinationToken": { "type": "string", "minLength": 32, "maxLength": 96, "pattern": "^[a-zA-Z0-9.-]+$" },
            "displayName": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 256 },
            "expiresAtUnixMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          } }
      }
    },
    "ExportProjectRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "export.project" },
        "params": { "type": "object", "additionalProperties": false,
          "required": ["destinationToken", "generation", "files"], "properties": {
            "destinationToken": { "type": "string", "minLength": 32, "maxLength": 96, "pattern": "^[a-zA-Z0-9.-]+$" },
            "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "files": { "type": "array", "minItems": 1, "maxItems": 32,
              "items": { "type": "object", "additionalProperties": false,
                "required": ["fileId", "content"], "properties": {
                  "fileId": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 },
                  "content": { "type": "string", "x-utf8MinBytes": 0, "x-utf8MaxBytes": 4194304 }
                } }
            }
          } }
      }
    },
    "ExportProjectResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "const": "export.project" },
        "result": { "type": "object", "additionalProperties": false,
          "required": ["generation", "complete", "writtenFiles", "failures"], "properties": {
            "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "complete": { "type": "boolean" },
            "writtenFiles": { "type": "array", "minItems": 0, "maxItems": 32, "items": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 } },
            "failures": { "type": "array", "minItems": 0, "maxItems": 32,
              "items": { "type": "object", "additionalProperties": false,
                "required": ["fileId", "code"], "properties": {
                  "fileId": { "type": "string", "x-utf8MinBytes": 0, "x-utf8MaxBytes": 4096 },
                  "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9.-]+$" }
                } }
            }
          } }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/ExportSelectDestinationRequest" },
    { "$ref": "#/$defs/ExportSelectDestinationResponse" },
    { "$ref": "#/$defs/ExportProjectRequest" },
    { "$ref": "#/$defs/ExportProjectResponse" }
  ]
}