{
  "name": "lightoverleaf-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "python ../../tools/contractcodegen/generate.py",
    "predev": "npm run codegen",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run codegen",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run codegen",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "monaco-editor": "0.56.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3"
  }
}
