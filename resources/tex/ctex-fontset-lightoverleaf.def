% No proprietary Windows fonts are copied or required.
\ExplSyntaxOn
\tl_set:Nn \CJKrmdefault { gbsn }
\tl_set:Nn \CJKsfdefault { gbsn }
\tl_set:Nn \CJKttdefault { gkai }
\NewDocumentCommand \songti { } { \CJKfamily { gbsn } }
\NewDocumentCommand \heiti { } { \CJKfamily { gbsn } \bfseries }
\NewDocumentCommand \fangsong { } { \CJKfamily { gbsn } }
\NewDocumentCommand \kaishu { } { \CJKfamily { gkai } }

\ExplSyntaxOff
