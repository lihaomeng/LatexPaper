{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightoverleaf:rpc:v2:system",
  "$defs": {
"AcceptedEvent": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event",
    "sessionId",
    "id",
    "generation",
    "sequence"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "event": {
      "type": "string",
      "const": "rpc.accepted"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
},
"CancellationResponse": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "sessionId",
    "id",
    "generation",
    "accepted"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "method": {
      "type": "string",
      "const": "rpc.cancel"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "accepted": {
      "type": "boolean"
    }
  }
},
    "ConnectedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "event", "sessionId"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "event": { "type": "string", "const": "rpc.connected" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "clientSequence",
        "method",
        "params"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "clientSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9.-]+$"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    "PingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "clientSequence",
        "ok",
        "method",
        "result"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "clientSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "method": {
          "type": "string",
          "const": "system.ping"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    "CapabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "clientSequence",
        "ok",
        "method",
        "result"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "clientSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "method": {
          "type": "string",
          "const": "system.getCapabilities"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeFiles",
            "build",
            "pdf",
            "syncTex"
          ],
          "properties": {
            "nativeFiles": {
              "type": "boolean"
            },
            "build": {
              "type": "boolean"
            },
            "pdf": {
              "type": "boolean"
            },
            "syncTex": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "clientSequence",
        "ok",
        "error"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "clientSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "messageKey"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENT",
                "METHOD_NOT_FOUND",
                "WORKSPACE_NOT_OPEN",
                "FILE_OPERATION_FAILED",
                "PATH_OUTSIDE_WORKSPACE",
                "FILE_NOT_FOUND",
                "FILE_CONFLICT",
                "BUILD_STALE_GENERATION",
                "BUILD_JOB_EXISTS",
                "BUILD_SNAPSHOT_EXISTS",
                "BUILD_OVERLAY_CONFLICT",
                "BUILD_DUPLICATE_OVERLAY",
                "COMPILER_NOT_FOUND",
                "BUILD_FAILED",
                "BUILD_TIMEOUT",
                "BUILD_CANCELLED",
                "SYNCTEX_NOT_AVAILABLE",
                "USER_CANCELLED",
                "INTERNAL_ERROR",
                "RESOURCE_EXHAUSTED"
              ]
            },
            "messageKey": {
              "type": "string",
              "const": "rpc.error"
            }
          }
        }
      }
    },
    "Cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "method",
        "sessionId",
        "id",
        "generation"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "method": {
          "type": "string",
          "const": "rpc.cancel"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "RequestEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "event",
        "sessionId",
        "id",
        "generation",
        "sequence",
        "outcome"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "event": {
          "type": "string",
          "const": "rpc.completed"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "timed-out"
          ]
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/AcceptedEvent" },
    { "$ref": "#/$defs/CancellationResponse" },
    { "$ref": "#/$defs/ConnectedEvent" },
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/PingResponse"
    },
    {
      "$ref": "#/$defs/CapabilitiesResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    },
    {
      "$ref": "#/$defs/Cancellation"
    },
    {
      "$ref": "#/$defs/RequestEvent"
    }
  ]
}
