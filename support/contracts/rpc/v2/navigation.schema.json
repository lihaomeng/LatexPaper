{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"lightoverleaf:rpc:v2:navigation",
 "$defs":{
  "NavigationForwardRequest":{"type":"object","additionalProperties":false,"required":["version","id","clientSequence","method","params"],"properties":{
   "version":{"type":"integer","const":2},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-zA-Z0-9-]+$"},
   "clientSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"method":{"type":"string","const":"navigation.forward"},
   "params":{"type":"object","additionalProperties":false,"required":["artifactId","fileId","line","column"],"properties":{
    "artifactId":{"type":"string","minLength":1,"maxLength":96,"pattern":"^[a-zA-Z0-9.-]+$"},"fileId":{"type":"string","x-utf8MinBytes":1,"x-utf8MaxBytes":4096},
    "line":{"type":"integer","minimum":1,"maximum":9007199254740991},"column":{"type":"integer","minimum":1,"maximum":9007199254740991}}}}},
  "NavigationForwardResponse":{"type":"object","additionalProperties":false,"required":["version","id","clientSequence","ok","method","result"],"properties":{
   "version":{"type":"integer","const":2},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-zA-Z0-9-]+$"},
   "clientSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"ok":{"type":"boolean","const":true},"method":{"type":"string","const":"navigation.forward"},
   "result":{"type":"object","additionalProperties":false,"required":["page","x","y"],"properties":{
    "page":{"type":"integer","minimum":1,"maximum":100000},"x":{"type":"integer","minimum":0,"maximum":10000000},"y":{"type":"integer","minimum":0,"maximum":10000000}}}}},
  "NavigationReverseRequest":{"type":"object","additionalProperties":false,"required":["version","id","clientSequence","method","params"],"properties":{
   "version":{"type":"integer","const":2},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-zA-Z0-9-]+$"},
   "clientSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"method":{"type":"string","const":"navigation.reverse"},
   "params":{"type":"object","additionalProperties":false,"required":["artifactId","page","x","y"],"properties":{
    "artifactId":{"type":"string","minLength":1,"maxLength":96,"pattern":"^[a-zA-Z0-9.-]+$"},"page":{"type":"integer","minimum":1,"maximum":100000},
    "x":{"type":"integer","minimum":0,"maximum":10000000},"y":{"type":"integer","minimum":0,"maximum":10000000}}}}},
  "NavigationReverseResponse":{"type":"object","additionalProperties":false,"required":["version","id","clientSequence","ok","method","result"],"properties":{
   "version":{"type":"integer","const":2},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-zA-Z0-9-]+$"},
   "clientSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"ok":{"type":"boolean","const":true},"method":{"type":"string","const":"navigation.reverse"},
   "result":{"type":"object","additionalProperties":false,"required":["fileId","line","column"],"properties":{
    "fileId":{"type":"string","x-utf8MinBytes":1,"x-utf8MaxBytes":4096},"line":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "column":{"type":"integer","minimum":1,"maximum":9007199254740991}}}}}
 },
 "oneOf":[{"$ref":"#/$defs/NavigationForwardRequest"},{"$ref":"#/$defs/NavigationForwardResponse"},{"$ref":"#/$defs/NavigationReverseRequest"},{"$ref":"#/$defs/NavigationReverseResponse"}]
}
