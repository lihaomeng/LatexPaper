{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightoverleaf:rpc:v2:workspace",
  "$defs": {
    "WorkspacePollChangesRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.pollChanges" },
        "params": { "type": "object", "additionalProperties": false,
          "required": ["workspaceId"], "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" }
          } }
      }
    },
    "WorkspacePollChangesResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "const": "workspace.pollChanges" },
        "result": { "type": "object", "additionalProperties": false,
          "required": ["changed"], "properties": { "changed": { "type": "boolean" } } }
      }
    },
    "WorkspaceTrashListRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.listTrash" },
        "params": { "type": "object", "additionalProperties": false,
          "required": ["workspaceId"], "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" }
          } }
      }
    },
    "WorkspaceTrashRestoreRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.restoreTrash" },
        "params": { "type": "object", "additionalProperties": false,
          "required": ["workspaceId", "trashId"], "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
            "trashId": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[a-zA-Z0-9-]+$" }
          } }
      }
    },
    "WorkspaceTrashListResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "const": "workspace.listTrash" },
        "result": { "type": "object", "additionalProperties": false,
          "required": ["entries"], "properties": {
            "entries": { "type": "array", "minItems": 0, "maxItems": 1000,
              "items": { "type": "object", "additionalProperties": false,
                "required": ["trashId", "originalFileId", "directory", "deletedAtUnixMs"],
                "properties": {
                  "trashId": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[a-zA-Z0-9-]+$" },
                  "originalFileId": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 },
                  "directory": { "type": "boolean" },
                  "deletedAtUnixMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                } }
            }
          } }
      }
    },
    "WorkspaceManageRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.manageFile" },
        "params": {
          "type": "object", "additionalProperties": false,
          "required": ["workspaceId", "operation", "fileId", "destination"],
          "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
            "operation": { "type": "string", "enum": ["create", "rename", "remove"] },
            "fileId": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 },
            "destination": { "type": "string", "x-utf8MinBytes": 0, "x-utf8MaxBytes": 4096 }
          }
        }
      }
    },
    "WorkspaceManageDirectoryRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.manageDirectory" },
        "params": {
          "type": "object", "additionalProperties": false,
          "required": ["workspaceId", "operation", "directoryId", "destination"],
          "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
            "operation": { "type": "string", "enum": ["create", "rename", "remove"] },
            "directoryId": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 },
            "destination": { "type": "string", "x-utf8MinBytes": 0, "x-utf8MaxBytes": 4096 }
          }
        }
      }
    },
    "WorkspaceReopenRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "const": "workspace.reopen" },
        "params": { "type": "object", "additionalProperties": false,
          "required": ["workspaceId"], "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" }
          } }
      }
    },
    "WorkspaceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "method", "params"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "method": { "type": "string", "enum": ["workspace.open", "workspace.close", "workspace.getState", "workspace.refresh"] },
        "params": { "type": "object", "additionalProperties": false, "required": [], "properties": {} }
      }
    },
    "WorkspaceStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "enum": ["workspace.open", "workspace.reopen", "workspace.getState", "workspace.refresh", "workspace.manageFile", "workspace.manageDirectory", "workspace.restoreTrash"] },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceId", "displayName", "revision", "entries"],
          "properties": {
            "workspaceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
            "displayName": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 1024 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
            "entries": {
              "type": "array",
              "minItems": 0,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fileId", "directory", "sizeBytes"],
                "properties": {
                  "fileId": { "type": "string", "x-utf8MinBytes": 1, "x-utf8MaxBytes": 4096 },
                  "directory": { "type": "boolean" },
                  "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                }
              }
            }
          }
        }
      }
    },
    "WorkspaceClosedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "clientSequence", "ok", "method", "result"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9-]+$" },
        "clientSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean", "const": true },
        "method": { "type": "string", "const": "workspace.close" },
        "result": { "type": "object", "additionalProperties": false, "required": [], "properties": {} }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/WorkspacePollChangesRequest" },
    { "$ref": "#/$defs/WorkspacePollChangesResponse" },
    { "$ref": "#/$defs/WorkspaceTrashListRequest" },
    { "$ref": "#/$defs/WorkspaceTrashRestoreRequest" },
    { "$ref": "#/$defs/WorkspaceTrashListResponse" },
    { "$ref": "#/$defs/WorkspaceManageRequest" },
    { "$ref": "#/$defs/WorkspaceManageDirectoryRequest" },
    { "$ref": "#/$defs/WorkspaceReopenRequest" },
    { "$ref": "#/$defs/WorkspaceRequest" },
    { "$ref": "#/$defs/WorkspaceStateResponse" },
    { "$ref": "#/$defs/WorkspaceClosedResponse" }
  ]
}
