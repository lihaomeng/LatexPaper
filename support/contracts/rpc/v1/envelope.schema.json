{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightoverleaf:rpc:v1:ping",
  "title": "M0 Ping request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "method",
    "params",
    "clientSequence"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "method": {
      "type": "string",
      "const": "system.ping"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "clientSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}

